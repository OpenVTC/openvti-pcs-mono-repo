         config = config.with_network_mode(address);
+    }
+    // OPENVTC-RESEARCH LOCAL PATCH (infra/PROVENANCE.md): the local research
+    // stack publishes every did:webvh on `localhost`, which the resolver's
+    // default `HostPolicy::PublicOnly` refuses. Opt in with
+    // MEDIATOR_ALLOW_PRIVATE_DID_HOSTS=1 (local stacks only, never deploy).
+    if std::env::var("MEDIATOR_ALLOW_PRIVATE_DID_HOSTS")
+        .map(|v| matches!(v.trim().to_ascii_lowercase().as_str(), "1" | "true" | "yes" | "on"))
+        .unwrap_or(false)
+    {
+        config = config.with_host_policy(
+            affinidi_did_resolver_cache_sdk::network_resolvers::HostPolicy::AllowPrivate,
+        );
     }
     config.build()
 }
